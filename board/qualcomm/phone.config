# Settings for phones
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_DEFAULT_ENV_FILE="board/qualcomm/qcom-phone.env"
CONFIG_PANIC_HANG=y
CONFIG_CMD_PAUSE=y
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_IGNORE_BOOTABLE=y
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1

# Many phones don't actually define a serial port in their DTS
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

CONFIG_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S3908=y

# Hypervisor (EL2) Support
CONFIG_ARMV8_PSCI=y
CONFIG_ARMV8_SWITCH_TO_EL1=n
CONFIG_ARMV8_EA_EL3_FIRST=y

# Virtualization features
# Disable MULTIENTRY to fix CPU_RELEASE_ADDR error
CONFIG_ARMV8_MULTIENTRY=n
CONFIG_SYS_HAS_NONSECURE=y


CONFIG_ARMV8_PSCI_CPUS_PER_CLUSTER=8

# for sm8250
# CONFIG_TEXT_BASE=0xa0080000

